return {
	"folke/tokyonight.nvim",
	lazy = false,
	priority = 1000,
	opts = {},
	config = function()
		require("tokyonight").setup({
			transparent = true, -- enables transparent background
			styles = {
				sidebars = "transparent", -- transparent sidebars (NvimTree, etc.)
				floats = "transparent", -- transparent floating windows
			},
		})
		vim.cmd.colorscheme("tokyonight-moon")
	end,
}
